{
  "name": "otter-edid-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser EDID editor \u2014 build an EDID from a resolution and refresh rate, or edit every field by hand, then check it against Analog Way, Barco and PixelHue hardware.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler deploy",
    "serve:dist": "python3 scripts/serve-dist.py --dir dist --port 4321",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:embed": "tsc -b && vite build --config vite.embed.config.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
