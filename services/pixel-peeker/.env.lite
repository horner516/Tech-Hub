# "lite" build: design tool + PDF report + Resolume export only.
#
# Drops the NovaStar cabinet schedule, LCT/VMP brief and JSON interchange. Those are
# honest but need explaining — they hand you a schedule to type in rather than the
# .scr/.nprj files people expect, because the VMP port mapping is still ambiguous.
# See docs/novastar-vmp-format.md.
VITE_NOVASTAR_EXPORTS=false
